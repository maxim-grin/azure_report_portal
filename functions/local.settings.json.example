{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "KEY_VAULT_URI": "https://reportportal-dev-kv.vault.azure.net/",
    "REPORTS_STORAGE_ACCOUNT_NAME": "reportportaldevstxxxxxx",
    "SQL_CONNECTION_STRING_SECRET": "sql-connection-string",
    "ACS_CONNECTION_STRING_SECRET": "acs-connection-string"
  }
}
